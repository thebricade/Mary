  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 396459964a4a45a4b7cef4c9082df875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  displayName: "Carlotta Giudicelli"
  title: "Prima donna of the Opera"
  tint: {r: 0.7, g: 0.15, b: 0.2, a: 1}
  lines:
  - text: "You! Do you know whose stage you are standing on?"
  - text: "Twenty years I have sung in this house. Twenty years! And now they want fresh faces."
  - text: "If one more of those notes comes to me, I will walk out and the theatre will be dark."
  - text: "A ghost? Ha! I am the only haunting this house needs."
  - text: "Run along, little one. The adults are working."
