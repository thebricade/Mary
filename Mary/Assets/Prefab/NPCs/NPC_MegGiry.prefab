--- !u!114 &1729636042085546
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1045190481525688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 396459964a4a45a4b7cef4c9082df875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  displayName: "Meg Giry"
  title: "A dancer in the ballet, and Christine's friend"
  tint: {r: 0.95, g: 0.7, b: 0.8, a: 1}
  lines:
  - text: "Not so loud! It's Box Five, you know, the box on the grand tier, next to the stage-box, on the left."
  - text: "Impossible! Six months ago, she used to sing like a CROCK! But do let us get by, my dear count, We are going to inquire after a poor man who was found hanging by the neck."
  - text: "Christine! There you are! Half the ballet has been whispering about you."
  - text: "Mother says I should not ask questions, which is exactly why I have so many."
  - text: "They say the ghost has a favourite. I would be terrified, but also a little jealous."
  - text: "I could show you a shortcut to the dressing rooms, if you promise not to tell."
  - text: "Whatever it is, you can tell me. I am better at secrets than I look."
