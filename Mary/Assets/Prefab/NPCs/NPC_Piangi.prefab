  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 396459964a4a45a4b7cef4c9082df875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  displayName: "Ubaldo Piangi"
  title: "The leading tenor"
  tint: {r: 0.8, g: 0.6, b: 0.15, a: 1}
  lines:
  - text: "Ah, little Christine! The chorus has a new bright spark."
  - text: "Practise your scales, and never trust a tenor who tells you he is not nervous."
  - text: "A good voice is a gift, but a good friend backstage is worth more than a trumpet."
  - text: "Our prima donna is in one of her moods again. Best to stay out of her way."
  - text: "Come, I will walk you to the stage door. These corridors are no place for a lone singer."
